{
  "server": {
    "port": 8090,
    "publicHost": "127.0.0.1",
    "comment": "服务端口和对外主机名（局域网请填 192.168.x.x）"
  },
  "admin": {
    "addresses": [
      "your-admin-address-here"
    ],
    "refreshIntervalMs": 15000,
    "usersCacheTtlMs": 3000,
    "comment": "管理员地址列表（小写），只有这些地址可以访问管理页面；refreshIntervalMs: 管理端列表页自动刷新间隔（毫秒），只在前台可见时轮询（切后台/切走标签页会停，回前台与切 tab 都会立即刷一次），默认 15000（15 秒），想更省可填 300000（5 分钟），此时用顶栏「刷新」按钮补实时性；usersCacheTtlMs: 列表接口的服务端短缓存（毫秒），多个管理员/标签页共享一次 docker 采样，任何状态写入都会立即失效它，默认 3000"
  },
  "cleanup": {
    "stopTimeoutMs": 900000,
    "destroyTimeoutMs": 3600000,
    "checkIntervalMs": 300000,
    "activityWindowMs": 180000,
    "processBaseline": 2,
    "stopGraceSeconds": 60,
    "comment": "stopTimeoutMs: 空闲多久后停止容器（毫秒），默认 15 分钟；destroyTimeoutMs: 停止多久后销毁容器（毫秒），默认 1 小时；checkIntervalMs: 检查间隔（毫秒），默认 5 分钟；activityWindowMs: 卷内会话文件多久没写入视为内部空闲（毫秒），默认 3 分钟，有写入说明容器内 DSH 仍在干活不会停；processBaseline: docker top 进程数超过此值视为有外部程序在跑，默认 2（基础进程数 1 + 1）；stopGraceSeconds: 停止前的 SIGTERM 宽限（秒），默认 60"
  },
  "resource": {
    "monitorIntervalMs": 30000,
    "autoUpgradeThreshold": 80,
    "autoUpgradeCooldownMs": 600000,
    "diskCheckIntervalMs": 300000,
    "comment": "monitorIntervalMs: 资源监控间隔（毫秒），默认 30 秒；autoUpgradeThreshold: 内存使用率超过此值自动升级配额（百分比）；autoUpgradeCooldownMs: 自动升级后冷却期（毫秒），防止反复升级重启；diskCheckIntervalMs: 磁盘使用采集间隔（毫秒），默认 5 分钟"
  },
  "usageLimit": {
    "enabled": true,
    "dailyMinutes": 120,
    "checkIntervalMs": 60000,
    "comment": "每日使用时限：enabled 开关；dailyMinutes 每个地址每天累计使用上限（分钟），容器运行即计时，超过后优雅停止，次日重置；已通过 CWT 验证的用户豁免；checkIntervalMs 超时检查间隔（毫秒）"
  },
  "cwt": {
    "enabled": true,
    "ttlMs": 300000,
    "allowCwtEnt": false,
    "comment": "CWT 申请-审批-出示：enabled 开关；ttlMs 出示 token 全局时效（毫秒，用于申请/出示时的防重放窗口）；审批时只复核签名、不校验时效（人工审批延迟不应失败）；allowCwtEnt: 预留字段——当前代码无任何实现，改它不会有效果（CWT_ENT 组形态尚未开发）"
  },
  "skills": {
    "autoInvoke": false,
    "comment": "技能市场信任边界（P0-4）：autoInvoke=false 时，市场技能安装到用户卷的副本强制注入 disable-model-invocation: true，模型不会自动调用，仅供用户显式使用；改 true 则放行自动调用（风险自担）"
  },
  "tiers": {
    "1": { "label": "基础", "memory": "512m", "disk": "1g", "cpus": "1.0", "pids": 256 },
    "2": { "label": "增强", "memory": "1g", "disk": "2g", "cpus": "2.0", "pids": 512 },
    "3": { "label": "高性能", "memory": "2g", "disk": "4g", "cpus": "4.0", "pids": 1024 }
  },
  "docker": {
    "image": "dsh-multitenant:latest",
    "basePort": 31000,
    "maxPort": 65535,
    "startupTimeoutMs": 120000,
    "comment": "image: Docker 镜像名称；basePort: 起始端口；maxPort: 最大端口；startupTimeoutMs: 容器启动超时（毫秒）"
  },
  "dsh": {
    "buildContext": ".",
    "allowLocalBuild": true,
    
    "registry": "https://registry.npmjs.org",
    "versionCacheTtlMs": 600000,
    "npmCacheDir": "",
    "npmTimeoutMs": 20000,
    "authActivateTimeoutMs": 8000,
    "backupDir": "",
    "backupBeforeApply": true,
    "comment": "DSH 版本升级/回退（管理端 /admin）。buildContext: docker build 上下文（相对项目根），需含 Dockerfile；allowLocalBuild: 允许平台自己构建镜像（需服务器有完整源码树）；registry: 版本列表来源 npm registry；versionCacheTtlMs: 版本列表缓存时长（毫秒，默认 10 分钟）；npmTimeoutMs: npm view 超时（毫秒）；npmCacheDir: npm view 缓存目录（留空自动用 data/npm-cache，规避宿主 ~/.npm 不可写导致的 EPERM）；authActivateTimeoutMs: DSH 浏览器认证「代激活」请求超时（毫秒，默认 8000）——容器刚重启、launch token 还没打印时可能超时，网络慢可调大；backupDir: 切换版本前卷快照目录（留空=平台 data/backups，运行用户必然可写；填绝对路径如 /backup/dsh-multitenant 需该目录可写，不可写会自动降级）；backupBeforeApply: 应用镜像前强制备份租户卷（强烈建议保持 true——版本间可能有存储格式差异，这是唯一可能真丢数据的风险点）"
  }
}
