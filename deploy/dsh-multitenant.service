# ============================================================================
#  dsh-multitenant 入口服务 systemd 单元（模板）
#  由 deploy/install.sh 用 sed 替换 __PLACEHOLDER__ 后写入 /etc/systemd/system/
# ============================================================================
[Unit]
Description=DSH Multitenant Entry Server
Documentation=file://__REMOTE_DIR__/README.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REMOTE_DIR__
Environment=PORT=__PORT__
Environment=PUBLIC_HOST=__PUBLIC_HOST__
Environment=PUBLIC_TRUST=__PUBLIC_TRUST__
# 存储形态（docs/storage-design.md）：install.sh 注入；env 优先级高于 config.json，
# 老机器升级即使 config.json 没 storage 段也生效（fail-closed：连不上库平台拒启）
Environment=DSH_STORAGE_PROVIDER=__STORAGE_PROVIDER__
Environment=MONGODB_URI=__MONGODB_URI__
# 对外形态（隧道/反代，2026-11-12）：PUBLIC_SCHEME=https + PUBLIC_PORT=外口 时，
# 进入容器/返回平台/cookie secure 全按对外口径。留空=按请求自动判形（本机形态零变化）。
# ⚠️ https 声明要求入口与全部租户网关端口都经隧道 https 终结（详见 utils/public-endpoint.js）
Environment=PUBLIC_SCHEME=__PUBLIC_SCHEME__
Environment=PUBLIC_PORT=__PUBLIC_PORT__
# 隧道同步面口令（frpc 与平台不同机时启用；同机回环留空即可）
Environment=TUNNEL_SYNC_TOKEN=__TUNNEL_SYNC_TOKEN__
# 可选：把宿主机同名环境变量注入每个租户容器（逗号分隔，如 DEEPSEEK_API_KEY）
#Environment=INJECT_ENV=
ExecStart=__NODE_BIN__ __REMOTE_DIR__/src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
